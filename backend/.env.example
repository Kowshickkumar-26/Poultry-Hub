# ==========================================================
# PoultryHub Backend Environment Configuration (.env)
# ==========================================================

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/poultry_management
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ==========================================================
# AI Chatbot / LLM Configuration
# ==========================================================
# Choose your provider: "gemini" | "openai" | "groq" | "openrouter" | "ollama"
AI_PROVIDER=gemini

# PASTE YOUR API KEY HERE:
AI_API_KEY=your_api_key_here

# (Optional) Model Name override:
# For Gemini: gemini-1.5-flash or gemini-2.0-flash
# For OpenAI: gpt-4o-mini or gpt-4o
# For Groq: llama-3.3-70b-versatile
AI_MODEL=gemini-1.5-flash

# (Optional) Base URL override:
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
